{# Ceres 5.0.86, resources/js/src/app/components/wishList/WishList.vue (AGPL-3.0).
   Only saleable documents have a visible entry. Compare on Ceres updates. #}
<!-- SSR:template(wish-list) -->
<script type="x/template" data-component="wish-list">
{% verbatim %}
<div data-wish-list>
  <transition-group name="list-transition" tag="div">
    <wish-list-item
        v-for="wishListItem in wishListItems.filter(row => row.data.filter && row.data.filter.isSalable && (!row.data.stock || row.data.stock.net == null || row.data.stock.net > 0))"
        :key="wishListItem.id"
        :data-wish-entry="wishListItem.data.variation.id"
        :wish-list-item-raw="wishListItem"
        :item-details-data="itemDetailsData">
    </wish-list-item>
  </transition-group>
  <p class="h4 text-muted text-center my-5" v-if="!isLoading && !wishListItems.some(row => row.data.filter && row.data.filter.isSalable && (!row.data.stock || row.data.stock.net == null || row.data.stock.net > 0))">{{ $translate("Ceres::Template.wishListNoItems") }}</p>
  <loading-animation v-if="isLoading"></loading-animation>

  <div v-if="wishListItems.some(row => row.data.filter && row.data.filter.isSalable && (!row.data.stock || row.data.stock.net == null || row.data.stock.net > 0))" class="vat small text-muted">
    {{ $translate("Ceres::Template.itemFootnote") }} <span v-if="showNetPrices">{{ $translate("Ceres::Template.itemExclVAT") }}</span>
    <span v-else>{{ $translate("Ceres::Template.itemInclVAT") }}</span>
    {{ $translate("Ceres::Template.itemExclusive") }}
    <a v-if="$ceres.config.global.shippingCostsCategoryId > 0" data-toggle="modal" href="#shippingscosts" class="text-appearance">{{ $translate("Ceres::Template.itemShippingCosts") }}</a>
    <a v-else :title="$translate('Ceres::Template.itemShippingCosts')">{{ $translate("Ceres::Template.itemShippingCosts") }}</a>
  </div>
</div>
{% endverbatim %}
</script>
<!-- /SSR -->
