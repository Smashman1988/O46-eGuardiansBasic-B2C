{% if categoryBreadcrumbs is not empty %}
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <ul class="list-no-style">
                    <li class="breadcrumb-item">
                        <a href="{{ homepageURL }}">
                            {{ trans("GuardiansBasic::Template.home") }}  
                        </a>
                    </li>
                    {% set break = false %}
                    {% for category in categoryBreadcrumbs[:categoryBreadcrumbs | length - 1] if not break %}
                        {% if category.details[0] %}
                            <li class="breadcrumb-item">
                                <a href="{{ services.category.getURLById( category.id ) }}" title="{{ category.details[0].name }}">{{ category.details[0].name }}</a>
                            </li>
                        {% else %}
                            {% set break = true %}
                        {% endif %}
                    {% endfor %}
                    {% set lastCategory = categoryBreadcrumbs | last %}
                    <li class="breadcrumb-item active"><span>{{ lastCategory.details[0].name }}</span></li>
                </ul>
            </div>
        </div>
    </div>
{% endif %}