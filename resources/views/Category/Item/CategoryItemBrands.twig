{% set currencycheck = services.checkout.getCurrencyData.name %}
{% set groups = {} %}
{% set currentScopeUrl = '' %}
{% for category in categories %}
    {% if category.id == 60 and category.details|length and megaMenuLevels|default(1) == 1 %}
        {% set detail = category.details[0] %}
        {% set currentScopeUrl = (urls.includeLanguage ? '/' ~ detail.lang : '') ~ '/' ~ detail.nameUrl %}
        {% set groups = getBrandGroups(category.children) %}
    {% endif %}
{% endfor %}
<div class="categoriegrid pt-0 page-content container-max">
    <div class="row">
        <div class="col-12">
                        <h1 class="center tcenter">{{ trans("GuardiansBasic::Template.brandstitle") }}</h1>
            <br>
            <p class="tcenter">
                {% for letter in 'A'..'Z' %}
                    {% if groups[letter] is defined %}<a class="brands-box" href="#{{ letter }}">{{ letter }}</a>{% else %}<span class="brands-box" aria-disabled="true">{{ letter }}</span>{% endif %}
                {% endfor %}
                {% if groups['0–9'] is defined %}<a class="brands-box" href="#end">0 - 9</a>{% endif %}
            </p>
            <div class="col-12"><p class="text-center"><a href="{{ services.category.getURLById(5618) }}{% if currencycheck != "EUR" %}?currency={{ currencycheck }}{% endif %}">- {{ trans("GuardiansBasic::Template.showall") }} -</a></p></div>
                        <div class="widget widget-step-by-step-navigation widget-none brandTiles">
                <div class="widget-inner">
                    <div class="row">
                    {% set renderedBrands = 0 %}
                    {% for firstSign, brands in groups %}
                        <div class="col-12"><hr><p class="firstletter" id="{{ firstSign == '0–9' ? 'end' : firstSign }}">{{ firstSign|upper }}</p><hr></div>
                        {%- for child in brands -%}
                            {%- set renderedBrands = renderedBrands + 1 -%}
                            {%- set brand = child.details[0] -%}
                            <div class="mb-3 col-12 col-sm-6 col-lg-4 col-xl-3">
                                <a href="{{ currentScopeUrl }}/{{ brand.nameUrl }}{{ urls.trailingSlashSuffix }}{% if currencycheck != "EUR" %}?currency={{ currencycheck }}{% endif %}" title="{{ brand.metaTitle }}" class="d-flex bg-light border rounded">
                                    <picture class="xy-150 rounded">
                                        {%- if brand.image2Path is empty -%}
                                            <img src="{{ plugin_path('GuardiansBasic') }}/images/no-logo-platzhalter.png" alt="{{ brand.name }}" class="position-relative rounded">
                                        {%- elseif renderedBrands <= 4 -%}
                                            <img src="/documents/{{ brand.image2Path }}" alt="{{ brand.name }}" title="{{ brand.name }}" class="position-relative rounded">
                                        {%- else -%}
                                            <img src="" alt="{{ brand.name }}" title="{{ brand.name }}" data-src="/documents/{{ brand.image2Path }}" class="lozad position-relative rounded"><noscript><img src="/documents/{{ brand.image2Path }}" alt="{{ brand.name }}" title="{{ brand.name }}"></noscript>
                                        {%- endif -%}
                                    </picture>
                                    <span class="align-self-center flex-grow-1 text-center">{{ brand.name }} ({{ child.itemCount[0].count }})</span></a>
                            </div>
                        {%- endfor -%}
                    {% endfor %}
        </div>
    </div>
</div>
                </div>
                </div>
                </div>
