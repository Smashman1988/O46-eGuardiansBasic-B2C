{% set ratingsAverage = getListFeedbackAverages(itemId)  %}

{% set anzahl1 = 0 %}
{% set anzahl2 = 0 %}
{% set anzahl3 = 0 %}
{% set anzahl4 = 0 %}
{% set anzahl5 = 0 %}
{% set anzahlTotals = ratingsAverage.ratingsCountTotal %}

{% set percentTotal = (ratingsAverage.averageValue / 5) * 100 %}

{#
