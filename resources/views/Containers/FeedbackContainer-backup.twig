 {% set singleRating = singleFeedBackRating.feedbackRating %}
 {% set singleRatingValue = singleRating.rating.ratingValue %}

 {% if singleRatingValue==1 %}
     {% set anzahl1 = anzahl1+1 %}
 {% elseif singleRatingValue==2 %}
