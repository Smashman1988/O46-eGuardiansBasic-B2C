{% set lang = services.localizationRepository.getLanguage() %}
{% set supportedLanguages = ['de', 'en', 'fr', 'it', 'es'] %}
{% set langSlug = {'de': '', 'en': '/en', 'fr': '/fr', 'it': '/it', 'es': '/es'}[lang]|default('') %}
{% set basketUrls = {'de': '/warenkorb/', 'en': '/en/shopping-cart/', 'fr': '/fr/Panier/', 'es': '/es/carrito-de-compras/', 'it': '/it/carrello/'} %}
{% set googlereviewlinks = {'de': '/google-bewertungen/', 'en': '/en/google-reviews/', 'fr': '/fr/avis-google/', 'es': '/es/resenas-de-google/', 'it': '/it/recensioni-di-google/'} %}
{% set loginTitles = {'de': 'Anmelden', 'en': 'Login', 'fr': 'S identifier', 'es': 'Iniciar sesión', 'it': 'Accedi'} %}
{% set flags = {'de': 'de', 'en': 'gb', 'fr': 'fr', 'es': 'es', 'it': 'it'} %}
{% set loginPreviewUrl = langSlug ~ '/loginPreview/' %}
{% set basketUrl = basketUrls[lang]|default('/warenkorb/') %}
{% set googlereviewlink = googlereviewlinks[lang]|default('/google-bewertungen/') %}
{% if lang in supportedLanguages %}
  {% import "GuardiansBasic::Category.Macros.CategoryTree" ~ lang|upper ~ ".twig" as Tree %}
{% else %}
  {% import "GuardiansBasic::Category.Macros.CategoryTree.twig" as Tree %}
{% endif %}
{% set basketItems = services.basket.getBasketForTemplate() %}
    {% set isVueView = false %}
{% if services.template.getCurrentTemplate() == "tpl.basket" or services.template.getCurrentTemplate() == "tpl.login" or services.template.isCheckout() or services.template.getCurrentTemplate() == "tpl.register" %}
    {% set isVueView = false %}
{% endif %}
{% set currencycheck = services.checkout.getCurrencyData.name %}
{% set currencyParam = currencycheck != "EUR" ? '?currency=' ~ currencycheck : '' %}


{#{% cacheblock use "header.topbar." ~ lang ~ "." ~ currencycheck %}#}
<div class="container nopadding">
        <div class="col-12 text-right lang-switcher nopadding">
           <span class="f-size16"><a href="{{ googlereviewlink }}">{{ trans("GuardiansBasic::Template.trustpilotinfo") }} <img fetchpriority="low" src="https://cdn02.outlet46.de/plugin/428/guardiansbasic/images/g-Logo.svg" alt="Outlet46.de" class="margin-right-10" style="vertical-align: middle;max-height: 25px;max-width: 80px;"></a></span>
            <button href="#" class="btn-small margin-right7-5 text-black" data-eg-handler="modalContent" data-eg-type="modal-lg" data-eg-event="click" data-eg-href="{{ langSlug }}/getShopBuilderContent/?categoryId=5638" data-eg-title="{{ trans("GuardiansBasic::Template.currency") }}">{{ services.checkout.getCurrencyData()['symbol'] }}</button>
            <button href="#" class="btn-small margin-right7-5 text-black" data-eg-handler="modalContent" data-eg-type="modal-lg" data-eg-event="click" data-eg-href="{{ langSlug }}/getShopBuilderContent/?categoryId=5640" data-eg-title="{{ trans('GuardiansBasic::Template.langchange') }}" aria-label="{{ trans('GuardiansBasic::Template.langchange') }}"><img fetchpriority="low" src="https://cdn02.outlet46.de/plugin/428/ceres/images/flags/4x3/{{ flags[lang]|default('de') }}.svg" class="flag-icon" alt="flag-{{ flags[lang]|default('de') }}"></button>
        </div>
</div>
{#{% endcacheblock %}#}
<header class="main-header stickyhead" id="page-header">
    <div class="eg-backdrop eg-backdrop-basket-prev transition" data-eg-handler="closeBackdrop" data-eg-event="click touchend"></div>
    <div class="header-wrap">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-5 col-sm-5 col-lg-3 col-xlg-3 col-xxlg-3 no-pad-right">
                    <a href="{{ langSlug }}/{{ currencyParam }}" title="Outlet46.de" class="company-logo"> 
                        <img fetchpriority="low" src="https://cdn02.outlet46.de/plugin/428/guardiansbasic/images/logo-outlet-new.svg" alt="Outlet46.de" class="o-logo"/>
                    </a>
                </div>  
                <div class="col-12 col-lg-5 col-xxlg-5 search-box">
                    {% if category.id not in vuejs %}
                    <div class="search-tel-wrap d-lg-flex align-items-center">
                        <div data-eg-search>
                            <div class="search-wrap">
                                <form action="{{ langSlug ~ '/search/' }}" method="get"> 
                                    <input type="text" class="form-control input-ff-search" placeholder="{{ trans("GuardiansBasic::Template.searchinfo") }}" data-eg-event="load" data-eg-handler="initLiveSearch" data-eg-livesearch name="query" autocomplete="off"  /> 
                                    <button class="btn-set-search fs35" aria-label="search">
                                        <span class="icon-search"></span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endif %}                    
                </div> 
                <div class="col-7 col-sm-7 col-md-7 col-lg-4">
                    <div class="d-flex justify-content-between justify-content-lg-end">
                        <button data-eg-event="click" data-eg-handler="tgClass" data-eg-param="html,menu-open" class="d-lg-none btn-mobile-nav text-black" aria-label="Menü öffnen">
                            <span class="icon-menu1 fs35"></span>
                            <span class="mobile-btn-txt">{{ trans("GuardiansBasic::Template.menu") }}</span>
                        </button>
                        {% if category.id in vuejs %}
                            {% else %}
                        <button class="d-lg-none btn-mobile-nav text-black" data-eg-event="click" data-eg-param="html,search-open" data-eg-handler="tgClass" aria-label="Suche öffnen">
                            <span class="icon-search-1 fs35"></span>
                            <span class="mobile-btn-txt">{{ trans("GuardiansBasic::Template.search") }}</span>
                        </button>
                        {% endif %}
                        <a href="{{ services.category.getURLById(5483) }}" title="Zur Merkliste" class="btn-mobile-nav wishlist-link noWishListItems text-black">
                            <span class="icon-heart1 fs35"></span> 
                            <span class="mobile-btn-txt ml-1">{{ trans("GuardiansBasic::Template.bookmarks") }}</span>
                            </span>
                        </a>
                        <button data-eg-event="click" data-eg-handler="modalContent" data-eg-href="{{ loginPreviewUrl }}" data-eg-title="{{ loginTitles[lang]|default('Login') }}" class="btn-unstyled btn-login-open btn-mobile-nav text-black" aria-label="Mein Konto öffnen">
                            <span class="icon-user fs35"></span> 
                            <span class="d-sm-block d-lg-block d-xxl-inline-block mobile-btn-txt">
                                <span>
                                    {{ trans("GuardiansBasic::Template.mykonto") }}
                                </span>
                            </span>
                        </button>
                      {% if category.id in vuejs %}
                       <div class="btn-unstyled btn-mobile-nav">
                           <a href="{{ basketUrl }}{{ currencyParam }}" class="text-black">
						   {% if basketItems.itemQuantity < 10 %}
						   <span class="header-quant-info"></span>
						   {% else %}
						   <span class="header-quant-info2"></span>
						   {% endif %}
                           <span class="icon-online-shopping-cart fs35 icon-head-menu"></span>
							
                            </a>
                        </div>
                       {% else %} 
                        <div data-eg-handler="initBasketPreview" data-eg-event="" class="btn-unstyled btn-mobile-nav">
                           <a href="{{ basketUrl }}{{ currencyParam }}" class="text-black">
						   {% if basketItems.itemQuantity < 10 %}
						   <span data-eg-basket-quantity class="header-quant-info">0</span>
						   {% else %}
						   <span data-eg-basket-quantity class="header-quant-info2">0</span>
						   {% endif %}
                           <span class="icon-online-shopping-cart fs35 icon-head-menu"></span>
				<span class="mobile-btn-txt d-sm-block d-lg-inline-block d-xxl-inline-block header-sum-info"> <span data-basket-sum="" class="d-sm-inline-block padding-l-10" v-basket-item-sum="$store.state.basket.data.itemSum">0,00</span><span data-currency-symbol>{{ services.checkout.getCurrencyData.symbol }}</span></span>
                           </a>

                        </div>   
                    {% endif %}
                    </div>                  
                </div>       
            </div>
        </div>
        <div class="basket-prev-small2">
            <div class="basket-prev-small-data"></div>
        </div>
    </div>
</header>
            <header class="main-header headpadding" id="page-header2">
    {% if isVueView %}     
        <div class="cat-subcats chechout-title-wrap header2-info">
            <div class="container">
                <div class="row">
                    <div class="col-md-5 cat-undercats-wrap">
                        {% set checkoutTitle = "" %}
                        {% if services.template.getCurrentTemplate() == "tpl.basket" %}
                            {% set checkoutTitle = "Warenkorb" %}
                        {% endif %}     
                        {% if services.template.getCurrentTemplate() == "tpl.login" %} 
                            {% set checkoutTitle = "Login" %}
                        {% endif %}     
                        {% if services.template.isCheckout() %}    
                            {% set checkoutTitle = "Kasse" %}
                        {% endif %}     
                        {% if  services.template.getCurrentTemplate() == "tpl.register" %}
                            {% set checkoutTitle = "Registrierung" %}
                        {% endif %}     
                        <div>
                            <h1 class="category-title">{{ checkoutTitle }}</h1>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <span class="bg-eck"></span>
                    </div>
                </div>
            </div>
        </div>
    {% else %}    
    {#{% cacheblock use "nav.categories." ~ lang ~ "." ~ currencycheck %}#}
    <nav class="d-print-none">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-static">
                    <div class="top-menu-wrapper"  data-eg-event="click" data-eg-target="[data-eg-open-ddown]">
                        <div class="basket-prev-title clearfix modal-header d-lg-none">
                            <span class="modal-title">{{ trans("GuardiansBasic::Template.categories") }}</span>
                            <button class="basket-prev-close close" data-eg-handler="tgClass" data-eg-param="html,menu-open" data-eg-event="click" aria-label="Close">
                                <span aria-hidden="true">×</span>
                            </button>
                        </div>                        
                        <ul class="top-menu" data-eg-event="click" data-eg-target="[data-eg-back-ddown]">
                          {{ Tree.get_nav_bar(categories, "") }}
                        </ul>
                    </div>
                </div>
            </div>
        </div> 
    </nav>
    {#{% endcacheblock %}#}
    {% endif %}     
</header>
{#{% cacheblock use "trustbar." ~ lang ~ "." ~ currencycheck %}#}
    <div class="top-top-bar">
    <div class="container"><noscript><div class="col-12 px-0 tcenter font-red">{{ trans("GuardiansBasic::Template.javanoactive") }}</div></noscript>
        <div class="row text-center d-md-flex vertrauen">
             <div class="col-md-3 col-lg-3 d-md-block px-0">
            &#9989; {{ trans("GuardiansBasic::Template.originalware") }} {#&#128666; {{ trans("GuardiansBasic::Template.Freeshippingreturns1") }}#}
            </div>
            <div class="col-12 col-md-3 col-lg-3 d-md-block px-0">
            &#129534; {{ trans("GuardiansBasic::Template.Purchaseoninvoice") }}
            </div>
            <div class="col-12 col-md-3 col-lg-3 d-md-block px-0">
            &#128260; {{ trans("GuardiansBasic::Template.100daysrighttoreturn") }}
            </div>
            <div class="col-12 col-md-3 col-lg-3 d-md-block px-0">
            &#127793;  {{ trans("GuardiansBasic::Template.Sustainableshopping") }} {#&#127873; {{ trans("GuardiansBasic::Template.christmas") }}#}
            </div>
        </div>
    </div>
</div>
{#{% endcacheblock %}#}
