{# === Canonical-Logik mit Pagination- und Content-Absicherung === #}

{# Nur erlaubte Parameter berücksichtigen (z. B. page) #}
{% set allowedParams = ['page'] %}
{% set paramPairs = [] %}
{% set currentPage = request.get('page') | default(1) | int %}
{% set pageMax = pageMax | default(1) %}
{% set hasPagination = pageMax > 1 %}
{% set isEmptyPage = hasPagination and currentPage > pageMax %}

{# Parameter nur übernehmen, wenn Seite gültig ist (keine leere Seite) #}
{% if not isEmptyPage %}
    {% for key in allowedParams %}
        {% set val = request.get(key) %}
        {% if val is not empty %}
            {% set pair = key ~ '=' ~ val %}
            {% set paramPairs = paramPairs | merge([pair]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{# Canonical zusammensetzen #}
{% set canonicalBase = services.url.getCanonicalURL() | split('?') | first %}
{% set queryString = paramPairs | length > 0 ? '?' ~ paramPairs | join('&') : '' %}
<link rel="canonical" href="{{ canonicalBase ~ queryString }}">

{# Alternate-Hreflang mit denselben Parametern wie Canonical #}
{% for lang, href in services.url.getLanguageURLs() %}
    {% if lang != 'x-default' %}
        {% set baseHref = href | split('?') | first %}
        <link rel="alternate" hreflang="{{ lang }}" href="{{ baseHref ~ queryString }}">
    {% endif %}
{% endfor %}
