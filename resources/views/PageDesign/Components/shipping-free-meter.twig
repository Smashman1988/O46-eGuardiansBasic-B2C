{# ======================  shipping-free-meter.twig  ====================== #}
{% set FREE_LIMITS  = { 'DE': 49.00 } %}
{% set FREE_LIMIT   = FREE_LIMITS['DE'] %}
{% set currencyData = services.checkout.getCurrencyData %}
{% set currencyCode = currencyData.name %}

<div id="o46-free-ship"
     class="o46-free-ship is-hidden"
     data-cur="{{ currencyCode }}"
     data-limit="{{ '%0.2f'|format(FREE_LIMIT) }}"
     aria-live="polite" aria-atomic="true">
  <div class="o46-bar-wrap" role="progressbar"
       aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <div class="o46-bar"></div>
    <div class="o46-bar-cap"></div>
  </div>
  <p class="o46-free-ship-text"><span class="o46-remaining"></span></p>
</div>
<script>
(function(){
  if (window.__O46_SHIPMETER_LITE__) return;
  window.__O46_SHIPMETER_LITE__ = true;

  function $(s,c){ return (c||document).querySelector(s); }
  function n(v){ v = Number(v); return isFinite(v) ? v : 0; }
  function clamp(v,min,max){ return Math.max(min, Math.min(max, v)); }
  function money(v,cur){
    try{ return new Intl.NumberFormat(document.documentElement.lang||'de-DE',{style:'currency',currency:cur||'EUR'}).format(n(v)); }
    catch(e){ v=n(v); return v.toFixed(2).replace('.',',')+' '+(cur||'EUR'); }
  }

  function unitPrice(it){
    if (it && it.price != null && it.price !== 'N / A') return n(it.price);
    if (it && it.amount && it.amount.priceGross != null && it.amount.priceGross !== 'N / A') return n(it.amount.priceGross);
    var p = it && it.prices && it.prices.default && it.prices.default.price && it.prices.default.price.value;
    return (p != null && p !== 'N / A') ? n(p) : 0;
  }
  function basketGross(items){
    var sum = 0;
    for (var i=0;i<(items?items.length:0);i++){
      var it = items[i], qty = n(it.quantity || 1);
      sum += unitPrice(it) * qty;
    }
    return sum;
  }

  function updateFrom(items, session){
    var box = $('#o46-free-ship'); if (!box) return;

    // Versandland = DE?
    var isDE = true;
    try{ isDE = !!(session && session.data && session.data.basket && Number(session.data.basket.shippingCountryId) === 1); }catch(_){}

    // Währung muss EUR sein (aus Session, sonst aus data-cur)
    var curFromSession = null;
    try{ curFromSession = session && session.data && session.data.basket && session.data.basket.currency; }catch(_){}
    var curAttr = box.getAttribute('data-cur') || 'EUR';
    var isEUR = (curFromSession ? curFromSession === 'EUR' : curAttr === 'EUR');

    if (!Array.isArray(items) || !items.length || !isDE || !isEUR){
      box.classList.add('is-hidden');
      return;
    }

    var cur   = 'EUR'; // Anzeige bleibt EUR, weil nur in EUR sichtbar
    var limit = n(box.getAttribute('data-limit') || 49);
    if (!(limit > 0)){ box.classList.add('is-hidden'); return; }

    var gross = basketGross(items);
    var remaining = Math.max(0, limit - gross);
    var percent = gross >= limit ? 100 : 100 * (gross / limit);
    percent = clamp(percent, 0, 100);

    box.classList.remove('is-hidden');

    var barWrap=$('.o46-bar-wrap',box),
        bar=$('.o46-bar',box),
        cap=$('.o46-bar-cap',box),
        txt=$('.o46-remaining',box);

    bar.style.width = percent.toFixed(2) + '%';
    barWrap.setAttribute('aria-valuenow', percent.toFixed(0));
    cap.textContent = money(limit, cur);

    if (gross < limit){
      box.classList.remove('o46-free-ship--done');
      txt.textContent = 'Noch ' + money(remaining,cur) + ' bis versandkostenfrei (ab ' + money(limit,cur) + ' in DE).';
    } else {
      box.classList.add('o46-free-ship--done');
      txt.textContent = 'Yeah! Dein Einkauf ist versandkostenfrei. (ab 49,00 € in DE)';
    }
  }

  // Nur auf Event reagieren
  window.addEventListener('o46:basket-updated', function(e){
    try{
      var d = e && e.detail || {};
      updateFrom(Array.isArray(d.items)?d.items:[], d.session||null);
    }catch(_){}
  });
})();
</script>
