{% set amounts = data.order.amounts[0] %}
{% set positions = [] %}
{% set brands = {} %}
{% for line in data.order.orderItems %}
    {% if line.typeId <= 2 %}
        {% set key = 'variation-' ~ line.itemVariationId %}
        {% if brands[key] is not defined %}
            {% set variation = services.item.getVariation(line.itemVariationId) %}
            {% set brands = brands|merge({(key): variation.documents[0].data.item.manufacturer.externalName ~ ''}) %}
        {% endif %}
        {% set position = {
            'pid': line.itemVariationId ~ '', 'prn': line.orderItemName ~ '', 'brn': brands[key],
            'pri': line.amounts[0].priceGross ~ '', 'qty': line.quantity ~ ''
        } %}
        {% set positions = positions|merge([position|json_encode]) %}
    {% endif %}
{% endfor %}
{# This program's bsk value is a comma-separated sequence of position objects. #}
{% set query = {
    'typ': 'i', 'trc': 'basket', 'ctg': 'sale', 'sid': 'checkout', 'cid': amounts.orderId ~ '',
    'orv': (amounts.grossTotal - amounts.shippingCostsGross) ~ '', 'orc': 'EUR',
    'bsk': positions|join(',')
} %}
<img class="display-none" src="//marketing.net.idealo-partner.com/ts/i5619682/tsa?{{ query|url_encode }}" width="1" height="1" border="0">
