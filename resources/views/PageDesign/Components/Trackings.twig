{% set uaId = 'UA-9915362-2' %}
{% set awId = 'AW-1030271873' %}
{% set awSendTo = 'AW-1030271873/ekQsCMz9gYsBEIHnousD' %}
{% set shopName = 'https://www.outlet46.de' %}

<script defer type="text/javascript" src="https://www.googletagmanager.com/gtag/js?id={{ uaId }}"  data-cookie-consent="tracking.googleAnalytics"></script>
<script defer type="text/javascript" data-cookie-consent="tracking.googleAnalytics">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ uaId }}', { 'anonymize_ip': true });
</script>     
