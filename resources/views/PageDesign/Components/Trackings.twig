{# KATEGORIE UND SUCHE #}
{#
{% if services.template.getCurrentTemplate()=="tpl.category.item" or services.template.isSearch() %}
    {% set itemIdsForAnalytics = [] %}
    {% set itemPricesForAnalytics = [] %}
    {% for item in itemList %}
        {% set itemIdsForAnalytics = itemIdsForAnalytics|merge([item.data.item.id]) %}
        {% set itemPricesForAnalytics = itemPricesForAnalytics|merge([item.data.prices.default.unitPrice.value]) %}
    {% endfor %}
    {% if services.template.isSearch() %}
    <script defer type="text/javascript" data-cookie-consent="tracking.googleAds">
        gtag('event', 'page_view', {'send_to': '{{ awId }}',
            'ecomm_prodid': {{ itemIdsForAnalytics | json_encode }},
            'ecomm_pagetype': 'searchresults', 
            'ecomm_totalvalue': {{ itemPricesForAnalytics | json_encode }}
        });
    </script>
    {% endif %}
    {% if services.template.isCategory() %}
    <script defer type="text/javascript" data-cookie-consent="tracking.googleAds">
        gtag('event', 'page_view', {'send_to': '{{ awId }}',
            'ecomm_prodid': {{ itemIdsForAnalytics | json_encode }},
            'ecomm_pagetype': 'category', 
            'ecomm_totalvalue': {{ itemPricesForAnalytics | json_encode }}
        });
   </script>
    {% endif %}
{% endif %}
