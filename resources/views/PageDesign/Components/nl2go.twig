            <script type="text/javascript">
                {% set taxCost = data.order.amounts[0].grossTotal - data.order.amounts[0].netTotal  %}
            n2g('ecommerce:addTransaction', {
                'id': '{{ data.order.id }}',
                'affiliation': 'https://www.outlet46.de',
                'revenue': '{{ data.order.amounts[0].grossTotal }}',
                'shipping': '{{ shippingCosts }}',
                'tax': '{{ taxCost }}'
            });
        {% for item in data.order.orderItems %}
        n2g('ecommerce:addItem', {
            'id': '{{ data.order.id }}',
            'name': '{{ item.orderItemName }}',
            'sku': '{{ item.variation.number }}',
            'category': '',
            'price': '{{ item.amounts[0].priceGross }}',
            'quantity': '{{ item.quantity }}'
        });
        {% endfor %}
        n2g('ecommerce:send');
    </script>