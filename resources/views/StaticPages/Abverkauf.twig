{% set itemListHomeTopSell = services.itemList.getItemList( "tag_list", "9", "sorting.price.avg_asc" ,50).documents %}            
<div class="row mt-4">
    <div class="col-xs-12">
        <div class="category-product-list row" data-eg-handler="initCatItemEvents" data-eg-event="load">
            {% if itemListHomeTopSell is not empty %}
                {% include 'GuardiansBasic::Category.Item.Partials.TagListCards' with { 'cardColumnClass': 'col-6 col-sm-6 col-md-4 col-lg-3 col-xxlg-25 m-b-3' } %}
            {% endif %}
        </div>
    </div>
</div>