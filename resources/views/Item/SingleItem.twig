{% set df = services.ItemCrossSellingService.setType('Accessory') %}
{% extends getPartial('page-design') %}
{% import "Ceres::PageDesign.Macros.LayoutContainer" as LayoutContainer %}
{# === Basisdaten sammeln === #}
{% set pdpQuickview = request.get('quickViewItem') is not empty %}
{% set itemData = item.documents[0].data %}
{% set rawFeedbackCount = itemData.item.feedbackCount ?? null %}
{% set pdpFeedbackCount = rawFeedbackCount is not iterable and rawFeedbackCount is not same as(true) and rawFeedbackCount matches '/^[0-9]+$/D' ? rawFeedbackCount : null %}
{% set ratingValue = itemData.item.feedbackDecimal ?? null %}
{% set validRating = ratingValue is not iterable and ratingValue is not same as(true) and ratingValue matches '/^[1-5](?:[.][0-9]+)?$/D' and ratingValue <= 5 %}
{# Detail properties and recommendation cards are omitted from Quickview. #}
{% if request.get('quickViewItem') is empty %}
{% set attributeCache = {
    46: trans("GuardiansBasic::Template.mainmaterial"),
    115: trans("GuardiansBasic::Template.materialcomposition"),
    105: trans("GuardiansBasic::Template.materialconstruction"),
    196: trans("GuardiansBasic::Template.lining"),
    197: trans("GuardiansBasic::Template.insole"),
    198: trans("GuardiansBasic::Template.outsole"),
    7: trans("GuardiansBasic::Template.colour"),
    107: trans("GuardiansBasic::Template.ablution"),
    108: trans("GuardiansBasic::Template.style"),
    122: trans("GuardiansBasic::Template.producttype"),
    111: trans("GuardiansBasic::Template.cutout"),
    73: trans("GuardiansBasic::Template.mfit"),
    127: trans("GuardiansBasic::Template.shoewidth"),
    110: trans("GuardiansBasic::Template.fitcut"),
    109: trans("GuardiansBasic::Template.waistband"),
    123: trans("GuardiansBasic::Template.sleevelength"),
    124: trans("GuardiansBasic::Template.sleevetype"),
    106: trans("GuardiansBasic::Template.dimensions"),
    118: trans("GuardiansBasic::Template.length"),
    119: trans("GuardiansBasic::Template.stridelength"),
    125: trans("GuardiansBasic::Template.heelheight"),
    102: trans("GuardiansBasic::Template.movementtype"),
    103: trans("GuardiansBasic::Template.display"),
    101: trans("GuardiansBasic::Template.careinstructions"),
    104: trans("GuardiansBasic::Template.clasp")
} %}
{% set translations = {
    tSustainability: trans("GuardiansBasic::Template.sustainability"),
    tAvailSizes: trans("GuardiansBasic::Template.availsizes"),
    tStatt: trans("GuardiansBasic::Template.statt"),
    tInBasket: trans("GuardiansBasic::Template.inbasket")
} %}
{% set transLabels = {
    availsizedeal: trans("GuardiansBasic::Template.availsizedeal"),
    availsizeonesize: trans("GuardiansBasic::Template.availsizeonesize"),
    morethen18: trans("GuardiansBasic::Template.morethen18")
} %}
{% endif %}
{% set itemId = itemData.item.id %}
{% set variationId = itemData.variation.id %}
{% set sortedItemImages = [] %}
{% set galleryUrls = [] %}
{% for photo in itemData.images.all|default([])|orderByKey('position') %}
    {% set full = photo.url|default(photo.urlLarge|default(photo.urlMiddle|default(photo.urlPreview|default('')))) %}
    {% if full|trim is not empty and full not in galleryUrls %}
        {% set galleryUrls = galleryUrls|merge([full]) %}
        {% set sortedItemImages = sortedItemImages|merge([{'url': full, 'urlMiddle': photo.urlMiddle|default(full), 'urlSecondPreview': photo.urlSecondPreview|default(photo.urlPreview|default(photo.urlMiddle|default(full)))}]) %}
    {% endif %}
{% endfor %}
{% set mainImg = sortedItemImages|first %}
{% set galleryCount = sortedItemImages|length %}

{# === Services & Daten === #}
{% set variationsWithAttributes = services.item.getVariationAttributeMap(itemId) %}
{% set lang = services.localizationRepository.getLanguage() %}
{% if not pdpQuickview %}
{% set detailurl = services.url.getCanonicalURL() %}
{% set basketItems = services.basket.getBasketForTemplate() %}
{% set pdpBasketForHeader = basketItems %}
{% set crossSellingList = services.item.getItemCrossSellingList(itemId) %}
{% set enabledRoutes = config("IO.routing.enabled_routes") | split(', ') %}
{% set itemAttributes = services.item.getAttributeNameMap(itemId) %}
{% endif %}
{# The picker uses the same concrete rows and sale decisions as this article's selector. #}
{% set wishRows = variationsWithAttributes|default([]) %}
{% if wishRows is empty and attributes|default([]) is empty and not itemData.filter.hasActiveChildren|default(false) %}
    {% set wishRows = [{'variationId': variationId}] %}
{% endif %}
{% set salableByVariation = {} %}
{% if wishRows and itemData.item.flagTwo|default(0) != 3 and
    (wishRows|length > 1 or variationsWithAttributes[0].attributes|default([]) or itemData.filter.isSalable is not defined) %}
    {% set salableByVariation = getVariationSalabilityMap(wishRows|map(v => v.variationId)) %}
{% endif %}
{% set wishChoices = getWishChoices(wishRows, pdpQuickview ? attributes|default([]) : itemAttributes.attributes|default({}),
    salableByVariation, itemAttributes.units|default({}), itemData, pdpQuickview) %}
{% set itemPrices = itemData.prices %}
{% set unitPriceValue = itemPrices.default.unitPrice.value ?? itemPrices.default.data.unitPrice ?? '' %}
{% set rrpUnitValue = itemPrices.rrp.unitPrice.value ?? itemPrices.rrp.data.unitPrice ?? '' %}
{% set pricePattern = '/^[0-9]+(?:[.][0-9]+)?(?:e[+-]?[0-9]+)?$/iD' %}
{% set hasUnitPrice = unitPriceValue matches pricePattern %}
{% set hasRRP = hasUnitPrice and rrpUnitValue matches pricePattern and rrpUnitValue > unitPriceValue %}
 
{% import "Ceres::PageDesign.Macros.ItemName" as ItemName %}
{% block PartialHead %}
{% if isQuickView %}
{% if mainImg.urlMiddle is not empty %}
    <link rel="preload" href="{{ mainImg.urlMiddle }}" as="image">
{% endif %}
{% set vendorlogo = itemData.item.manufacturer.logo | replace({'https://cdn02.outlet46.de/frontend/vendor/': plugin_path('GuardiansBasic') ~ '/images/vendors/'}) %}
{% if vendorlogo and itemData.item.manufacturer.url is not empty %}
<link rel="preload" href="{{ vendorlogo }}" as="image">    
{% elseif itemData.item.manufacturer.logo and itemData.item.manufacturer.url is not empty %}
<link rel="preload" href="{{ itemData.item.manufacturer.logo }}" as="image">{% endif %}
    {% embed getPartial('page-metadata') %}
        {% block title          ItemName.get(itemData | itemName, itemData.variation.bundleType) %}
        {% block description    itemData.texts.metaDescription %}
        {% block keywords       itemData.texts.keywords %}
        {% block image          itemData.images.all[0].url %}
        {% block schemaOrg %}
            {% set offer = {
                '@type': 'Offer', 'priceCurrency': itemData.prices.default.currency ~ '',
                'url': detailurl ~ ''
            } %}
            {% if itemData.variation.availability.mappedAvailability is not empty %}
                {% set offer = offer|merge({'availability': itemData.variation.availability.mappedAvailability}) %}
            {% endif %}
            {% if conditionOfItem is not empty %}
                {% set offer = offer|merge({'itemCondition': conditionOfItem}) %}
            {% endif %}
            {% if hasUnitPrice %}
                {% set offer = offer|merge({'price': unitPriceValue|number_format(2, '.', '')}) %}
                {# Ceres resolves this optional date from the configured variation property. #}
                {% set expiry = priceValidUntil|default('') %}
                {% if expiry matches '/^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$/D' and expiry >= 'now'|date('Y-m-d') and expiry|date('Y-m-d') == expiry %}
                    {% set offer = offer|merge({'priceValidUntil': expiry}) %}
                {% endif %}
            {% endif %}
            {% set basePrice = itemData.prices.default.baseSinglePrice ?? null %}
            {% if itemData.prices.default.baseLot > 0 and basePrice matches pricePattern %}
                {% set offer = offer|merge({'priceSpecification': {
                    '@type': 'UnitPriceSpecification', 'price': basePrice|number_format(2, '.', ''),
                    'priceCurrency': offer.priceCurrency,
                    'referenceQuantity': {'@type': 'QuantitativeValue', 'value': itemData.prices.default.baseLot ~ '',
                        'unitCode': itemData.prices.default.baseUnit ~ ''}
                }}) %}
            {% endif %}
            {# The Ceres macro renders an HTML label. JSON-LD needs its text content. #}
            {% set schemaName = ItemName.get(itemData|itemName, itemData.variation.bundleType)|trim|replace({'&lt;':'<', '&gt;':'>', '&quot;':'"', '&#039;':"'", '&amp;':'&'}) %}
            {% set product = {
                '@context': 'http://schema.org/', '@type': 'Product', '@id': itemData.variation.id ~ '',
                'name': schemaName,
                'category': defaultCategory.details[0].name ~ '', 'releaseDate': itemData.variation.releasedAt ~ '',
                'image': itemData.images.all[0].urlMiddle ~ '', 'identifier': itemData.variation.id ~ '',
                'description': itemData.texts.description|default('')|striptags|filterTabs,
                'disambiguatingDescription': itemData.texts.shortDescription ~ '',
                'sku': itemData.variation.number ~ '', 'offers': offer
            } %}
            {% set manufacturerName = manufacturer|default(itemData.item.manufacturer.externalName|default('')) %}
            {% set brandName = brand|default(itemData.item.manufacturer.externalName|default('')) %}
            {% if brandName is not empty %}
                {% set product = product|merge({'brand': {'@type': 'Brand', 'name': brandName}}) %}
            {% endif %}
            {% if manufacturerName is not empty %}
                {% set product = product|merge({'manufacturer': {'@type': 'Organization', 'name': manufacturerName}}) %}
            {% endif %}
            {% for dimension, value in {'depth': itemData.variation.lengthMM|default(0), 'width': itemData.variation.widthMM|default(0), 'height': itemData.variation.heightMM|default(0)} %}
                {% if value matches pricePattern and value > 0 %}
                    {% set product = product|merge({(dimension): {'@type': 'QuantitativeValue', 'value': value, 'unitCode': 'MMT'}}) %}
                {% endif %}
            {% endfor %}
            {% if itemData.variation.weightG matches pricePattern and itemData.variation.weightG > 0 %}
                {% set product = product|merge({'weight': {'@type': 'QuantitativeValue', 'value': itemData.variation.weightG, 'unitCode': 'GRM'}}) %}
            {% endif %}
            {% set untypedGtin = '' %}
            {% for barcode in itemData.barcodes|default([]) %}
                {% set type = barcode.type|default(barcode.barcodeType|default(''))|trim|upper %}
                {% if product.gtin13 is not defined and barcode.code matches '/^[0-9]{13}$/D' %}
                    {% if type in ['GTIN_13', 'EAN_13', 'EAN13', 'EAN'] %}
                        {% set product = product|merge({'gtin13': barcode.code ~ ''}) %}
                    {% elseif type == '' and untypedGtin == '' %}
                        {% set untypedGtin = barcode.code ~ '' %}
                    {% endif %}
                {% endif %}
            {% endfor %}
            {% if product.gtin13 is not defined and untypedGtin != '' %}
                {% set product = product|merge({'gtin13': untypedGtin}) %}
            {% endif %}
            {% if pdpFeedbackCount > 0 and validRating %}
                {% set product = product|merge({'aggregateRating': {
                    '@type': 'AggregateRating', 'ratingValue': itemData.item.feedbackDecimal ~ '',
                    'ratingCount': itemData.item.feedbackCount ~ '', 'bestRating': '5', 'worstRating': '1'
                }}) %}
            {% endif %}
            {{ product|json_encode(15)|raw }}
        {% endblock %}
    {% endembed %}
{% endif %}
{% endblock %}
{% block PageBody %}
{% if not isQuickView %}
<script>
(function () {
    try {
        var url = new URL(window.location.href);
        if (url.searchParams.get('quickViewItem') === 'true') {
            url.searchParams.delete('quickViewItem');
            window.location.replace(url.origin + url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : ''));
        }
    } catch (e) {
        console.warn('[MiniFailsafe] Fehler:', e);
    }
})();
</script>
{% endif %}
<article class="single" data-item data-eg-active-variation="{{ itemData.variation.id }}" data-mainitemid="{{ itemData.item.id }}">  
    <div class="container">
        <div class="{{ isQuickView ? 'row eg-product-columns' : 'clearfix' }}">
            {% if isQuickView %}
            <div class="col-12 col-md-6 stickyarticle z-index1">
                <div class="row eg-item-gallery">
                    <div class="col-md-2 col-lg-2 col-xl-2 d-none d-md-block eg-gallery-thumbnails">

                         {% set stepIndex = 0 %}
                        <div class="single-prev-images d-none d-md-block">
                            {% for prevImg in sortedItemImages %}
                                <a href="{{ prevImg.url }}" rel="zoom-id:ItemImgZoom" data-image="{{ prevImg.urlMiddle }}" title="{{ itemData | itemName }}" data-stepindex="{{ stepIndex - 3 }}">
                                    <img src="" data-src="{{ prevImg.urlSecondPreview }}" alt="{{ itemData | itemName }}" title="{{ itemData | itemName }}" class="lozad" width="100%" height="100%"/>
                                </a>
                                {% set stepIndex = stepIndex+1 %}
                            {% endfor %}
                        </div>
                    </div>
                    <div class="col-md-10 col-lg-10 col-xl-10">
                        <div class="relative eg-gallery-frame" data-eg-gallery-count="{{ galleryCount }}">
                            {% set storeSpecialClass = '' %}
                            {% set storeSpecialTxt = '' %}
                            {% if itemData.item.storeSpecial.id == 2 %}
                                {% set storeSpecialClass = 'i-action-top' %}
                                {% set storeSpecialTxt = 'Top' %}
                            {% endif %}
                            {% if itemData.item.storeSpecial.id == 3 %}
                                {% set storeSpecialClass = 'i-action-new' %}
                                {% set storeSpecialTxt = 'Neu' %}
                            {% endif %}
                            {% if storeSpecialClass is not empty %}
                            <span data-eg-item-special class="item-action {{ storeSpecialClass }}{% if hasRRP %} d-none{% endif %}">{{ storeSpecialTxt }}</span>
                            {% endif %}
                            <span data-eg-item-discount class="item-action i-action-sale{% if not hasRRP %} d-none{% endif %}"><span data-eg-item-rrp-percent>{{ hasRRP ? ((1 - unitPriceValue / rrpUnitValue) * -100)|number_format(dezimalcount, ',', '.') : '' }}</span>%</span>
                                                        {% for tag in itemData.tags %}
                                                        {% if tag.id == 284 %}
                                                        <span class="item-action i-action-nachhaltig-item">{{ trans("GuardiansBasic::Template.sustainability") }}</span>
                                                        {% endif %}
                                                        {% endfor %}
                            <span class="wishlist-info1" data-wish-product="{{ wishChoices|json_encode }}"></span>
                            <a {% if galleryCount %}href="{{ mainImg.url }}"{% endif %} aria-label="{{ itemData | itemName }}" title="{{ itemData | itemName }}" id="ItemImgZoom" class="eg-pdp-photo {% if galleryCount %}MagicZoomPlus{% endif %}" data-options="zoomMode: off; transitionEffect: false; lazyZoom: true; cssClass: white-bg; textBtnClose: {{ trans('GuardiansBasic::Template.facetClose') }}; textBtnNext: {{ trans('GuardiansBasic::Template.galleryNext') }}; textBtnPrev: {{ trans('GuardiansBasic::Template.galleryPrevious') }}; textHoverZoomHint: ; textClickZoomHint: ; textExpandHint:    " data-mobile-options="zoomMode: off; textTouchZoomHint: ; textClickZoomHint: ; textExpandHint: ">
                                <img fetchpriority="high" {% if galleryCount %}src="{{ mainImg.urlMiddle }}"{% endif %} alt="{{ itemData | itemName }}" title="{{ itemData | itemName }}"  width="560px" height="560px">
                            </a>
                            {# Modeldaten zwischenspeichern – nur ein Loop! #}
                            {% set modelHeight = null %}
                            {% set modelWeight = null %}
                            {% set modelSize = null %}

                            {% for prop in item.documents[0].data.properties %}
                                {% if prop.property.id == 231 and prop.texts.value is not empty %}
                                    {% set modelHeight = prop.texts.value %}
                                {% elseif prop.property.id == 78 and prop.texts.value is not empty %}
                                    {% set modelWeight = prop.texts.value %}
                                {% elseif prop.property.id == 77 and prop.texts.value is not empty %}
                                    {% set modelSize = prop.texts.value %}
                                {% endif %}
                            {% endfor %}

                            {# Ausgabe nur wenn etwas vorhanden ist #}
                            {% if modelHeight is not empty %}
                            <div class="modelinfo-1" style="">
                              <span class="modelinfo-2" style="" data-darkreader-inline-bgcolor="">
                                <span class="modelinfo-3" style="" data-darkreader-inline-color="">
                                  {{ trans("GuardiansBasic::Template.ourmodelis") }} ({{ modelHeight }} {{ trans("GuardiansBasic::Template.cmtall") }}
                                  {% if modelWeight %} - {{ modelWeight }}{{ trans("GuardiansBasic::Template.kg") }}{% endif %})
                                  {% if modelSize %}
                                    <br>{{ trans("GuardiansBasic::Template.ourmodelwearssize") }}: {{ modelSize }}
                                  {% endif %}
                                </span>
                              </span>
                            </div>
                            {% endif %}

                            <span class="eg-gallery-counter" data-eg-gallery-counter{% if galleryCount < 2 %} hidden{% endif %}>{% if galleryCount > 1 %}1 / {{ galleryCount }}{% endif %}</span>
                            <button type="button" class="eg-gallery-expand" aria-label="{{ trans('GuardiansBasic::Template.galleryExpand') }}">
                                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="10" cy="10" r="7.5"/><path d="M16 16l6 6M6 10h8M10 6v8"/></svg>
                                <span>{{ trans('GuardiansBasic::Template.galleryExpand') }}</span>
                            </button>
                            <button type="button" class="zoombtnnav zoomnavleft" aria-label="{{ trans('GuardiansBasic::Template.galleryPrevious') }}"><span class="icon-left-open-big" aria-hidden="true"></span></button>
                            <button type="button" class="zoombtnnav zoomnavright" aria-label="{{ trans('GuardiansBasic::Template.galleryNext') }}"><span class="icon-right-open-big" aria-hidden="true"></span></button>
                        </div>
                    </div>
                </div>
            </div>
           {% endif %}
           {% if isQuickView %}
            <div class="col-12 col-md-6" data-eg-loading-attr>
                {% endif %}
                {% if pdpQuickview %}<span class="eg-quick-wish" data-wish-product="{{ wishChoices|json_encode }}"></span>{% endif %}
                <h1 class="item-title" data-eg-item-title>{{ itemData | itemName }}</h1>
                 {% if isQuickView %}
                    {% if pdpFeedbackCount > 0 and validRating %}
                        {% set percentTotal = (itemData.item.feedbackDecimal / 5) * 100 %}
                    <div class="item-ratings-top item-ratings-head clearfix d-inline-block item-ratings-first bew-abstand display-flex-important">
                        <div class="rating-grey f-size14">
                            {% for i in 1..5 %}
                            <span class="icon-star"></span>
                            {% endfor %}
                        </div>
                        <div class="rating-fuller" style="width: {{ percentTotal }}%"> 
                            <div class="rating-fuller-inner f-size14">
                                {% for i in 1..5 %}
                                <span class="icon-star"></span>
                                {% endfor %}
                            </div>
                        </div>
                    <div class="tab-rating-info"><a href="#tabrating" title="Bewertung {{ itemData.item.feedbackCount }}" class="slideToRating">{{ trans("GuardiansBasic::Template.ratingtitle") }}</a></div>
                    </div>
                    {% endif %}
                {% endif %}
                <hr class="hr-style">
                {% if isQuickView %}
                    <div class="eg-product-offer">
                    {% if itemData.filter.hasManufacturer %}
                        {% set hasLogo = itemData.item.manufacturer.logo is not empty %}
                        {% set hasUrl = itemData.item.manufacturer.url is not empty %}
                        {% if hasLogo and hasUrl %}
                            {% set vendorlogo = itemData.item.manufacturer.logo | replace({'https://cdn02.outlet46.de/frontend/vendor/': plugin_path('GuardiansBasic') ~ '/images/vendors/'}) %}

                            {# Default-URLs setzen #}
                            {% set categoryURL = '#' %}
                            {% set categoryURLint = '#' %}

                            {# Wenn manufacturer.url numerisch ist, als categoryId behandeln #}
                            {% if itemData.item.manufacturer.url matches '/^[0-9]+$/' %}
                                {% set prodcatid = itemData.item.manufacturer.url | int %}
                                {% set categoryURLService = services.url.getCategoryURL(prodcatid) %}
                                {% set categoryURL = categoryURLService.toAbsoluteUrl(false) %}
                                {% set categoryURLint = categoryURLService.toAbsoluteUrl(true) %}
                            {% endif %}

                            <div class="eg-product-brand">
                                <span class="item-producer-img mt-0">
                                    <a href="{{ lang == 'de' ? categoryURL : categoryURLint }}">
                                        <img src="{{ vendorlogo }}" alt="{{ itemData.item.manufacturer.externalName }} Logo" title="{{ itemData.item.manufacturer.externalName }}" width="100px" height="100px">
                                    </a>
                                </span>
                            </div>
                        {% endif %}
                    {% endif %}
                    <div class="eg-product-price{% if itemData.prices.graduatedPrices|length>1 %} hasGruadetPrices{% endif %}">
                    <span class="bold single-item-price{% if not hasUnitPrice %} d-none{% endif %}">
                      <span data-eg-item-price class="bold single-item-price">
                        {{ hasUnitPrice ? unitPriceValue|number_format(2, ',', '.') : '' }}
                      </span>
                      {{ currencyData[currencyFormat] }}
                    </span>

                    {% set rabatt = hasRRP ? (rrpUnitValue - unitPriceValue)|number_format(2, ',', '.') : '' %}

                    <div data-eg-item-discount class="cat-rrp-item{% if not hasRRP %} d-none{% endif %}">
                      <span class="cat-rrp-item-price">
                        {{ trans("GuardiansBasic::Template.statt") }}
                        <span data-eg-item-rrp class="cat-rrp-item-price">
                          {{ hasRRP ? rrpUnitValue|number_format(2, ',', '.') : '' }}
                        </span>
                        {{ currencyData[currencyFormat] }}
                      </span>*</div>

                    <div data-eg-item-discount class="cat-rrp-item{% if not hasRRP %} d-none{% endif %}">
                      <span class="single-item-rabatt">
                        {{ trans("GuardiansBasic::Template.Dusparst") }}
                        <span data-eg-item-rrp-spar class="single-item-rabatt">{{ rabatt }}</span>
                        {{ currencyData[currencyFormat] }}!
                      </span>
                    </div>
                    <div class="eg-product-shipping">
                    {% if currencyData.name == 'EUR' and hasUnitPrice and unitPriceValue >= 54 %}
                    <span class="sofort-lieferbar font-12">{{ trans("GuardiansBasic::Template.ab29") }}</span>
                    {% else %}
                    <span class="sofort-lieferbar font-12">{{ trans("GuardiansBasic::Template.u29") }}</span>  
                    {% endif %} 
                    {#<br>
                    <span class="sofort-lieferbar font-12">{{ trans("GuardiansBasic::Template.samedayshipping") }}</span>#}
                    </div>
                        {#<a href="#" data-eg-handler="modalContent" data-eg-type="modal-lg" data-eg-event="click" data-eg-href="{% if lang == "de" %}{% elseif lang == "en" %}/en{% elseif lang == "fr" %}/fr{% elseif lang == "it" %}/it{% elseif lang == "es" %}/es{% endif %}/getShopBuilderContent?categoryId=5934" data-eg-title="{{ trans("GuardiansBasic::Template.10percentcode") }}"><div class="benefit-detailview"><span class="benefit-detailview--text">{{ trans("GuardiansBasic::Template.10percentcode") }}</span></div></a>#}
                    </div>
                    </div>
                    <hr class="hr-style">
                {% endif %}

                {% set linkedAttributes = [] %}
                {% set linkedSelectionComplete = false %}
                {% if variationsWithAttributes[0].attributes  | length > 0 %}
                 {% if itemData.item.flagTwo!=3 %}   
                    {% set salableAttributeValues = getSalableAttributeValues(variationsWithAttributes, salableByVariation) %}
                {% endif %}
                              {% for property in item.documents[0].data.properties %}
                                {% if property.property.id in [110, 73] %}
                                  <p class="margin-top-0-bottom-05{% if property.property.id == 110 %} f-size12" style="background-color: lightgrey; padding: 10px;{% endif %}">
                                    <span class="font-w700">
                                      {% if property.property.id == 73 %}{{ trans("GuardiansBasic::Template.fit") }}: {% endif %}{{ property.selection.name }}
                                    </span>
                                  </p>
                                {% endif %}
                              {% endfor %}
                {# IO's explicit itemId_variationId route already renders the chosen variation. #}
                {% if request.get('quickViewItem') is empty and (request.getRequestUri()|split('?')|first|trim('/')|split('/')|last) == (itemData.item.id ~ '_' ~ itemData.variation.id) %}
                    {% for candidate in variationsWithAttributes %}
                        {% if candidate.variationId == itemData.variation.id and (itemData.item.flagTwo == 3 or salableByVariation[candidate.variationId]) %}
                            {% set linkedAttributes = candidate.attributes %}
                        {% endif %}
                    {% endfor %}
                {% endif %}
                <div data-item-variation class="row" data-eg-handler="initVariation" data-eg-event="load" data-eg-variations="{{ variationsWithAttributes | json_encode() }}">
                {% set linkedSelectionComplete = linkedAttributes is not empty and linkedAttributes|length == attributes|length %}
                {% for itemAttribute in attributes %}
                    {% set activeAttrName = "" %}
                    {% set linkedAttribute = linkedAttributes|filter(a => a.attributeId == itemAttribute.attributeId)|first %}
                    {% set linkedValue = linkedAttribute ? itemAttribute.values|filter(v => v.attributeValueId == linkedAttribute.attributeValueId)|first : null %}
                    {% if not linkedValue %}{% set linkedSelectionComplete = false %}{% endif %}
                    <div class="col-md-12 padding-10-0">
                        {% set isColorAttr = false %}
                        {% set setBoxAttr = true %}
                        {% if "Farb" in itemAttribute.name or "Color" in itemAttribute.name %}
                            {% set isColorAttr = true %}
                        {% endif %}
                         <div data-item-variation-select class="{% if isColorAttr==true or setBoxAttr==true %}attribute-box{% else %}attribute-dropdown{% endif %}">
                             <p class="select-attr-name">{{ itemAttribute.name }}: <span data-eg-selected-attribute>{{ linkedValue ? linkedValue.name : trans("GuardiansBasic::Template.selection") }}</span></p>
                             <p class="data-stock-warn"></p>
                            {% if "<table" in itemData.texts.technicalData|raw %}
