{% set df = services.ItemCrossSellingService.setType('Accessory') %}
{% extends getPartial('page-design') %}
{% import "Ceres::PageDesign.Macros.LayoutContainer" as LayoutContainer %}
{# === Basisdaten sammeln === #}
{% set itemData = item.documents[0].data %}
          {% set attributeCache = {
    46: trans("GuardiansBasic::Template.mainmaterial"),
    115: trans("GuardiansBasic::Template.materialcomposition"),
    105: trans("GuardiansBasic::Template.materialconstruction"),
    196: trans("GuardiansBasic::Template.lining"),
    197: trans("GuardiansBasic::Template.insole"),
    198: trans("GuardiansBasic::Template.outsole"),
    7: trans("GuardiansBasic::Template.colour"),
    107: trans("GuardiansBasic::Template.ablution"),
    108: trans("GuardiansBasic::Template.style"),
    122: trans("GuardiansBasic::Template.producttype"),
    111: trans("GuardiansBasic::Template.cutout"),
    73: trans("GuardiansBasic::Template.mfit"),
    127: trans("GuardiansBasic::Template.shoewidth"),
    110: trans("GuardiansBasic::Template.fitcut"),
    109: trans("GuardiansBasic::Template.waistband"),
    123: trans("GuardiansBasic::Template.sleevelength"),
    124: trans("GuardiansBasic::Template.sleevetype"),
    106: trans("GuardiansBasic::Template.dimensions"),
    118: trans("GuardiansBasic::Template.length"),
    119: trans("GuardiansBasic::Template.stridelength"),
    125: trans("GuardiansBasic::Template.heelheight"),
    102: trans("GuardiansBasic::Template.movementtype"),
    103: trans("GuardiansBasic::Template.display"),
    101: trans("GuardiansBasic::Template.careinstructions"),
    104: trans("GuardiansBasic::Template.clasp")
} %}
{% set translations = {
    tSustainability: trans("GuardiansBasic::Template.sustainability"),
    tAvailSizes: trans("GuardiansBasic::Template.availsizes"),
    tStatt: trans("GuardiansBasic::Template.statt"),
    tInBasket: trans("GuardiansBasic::Template.inbasket")
} %}
{% set transLabels = {
    availsizedeal: trans("GuardiansBasic::Template.availsizedeal"),
    availsizeonesize: trans("GuardiansBasic::Template.availsizeonesize"),
    morethen18: trans("GuardiansBasic::Template.morethen18")
} %}
{% set itemId = itemData.item.id %}
{% set variationId = itemData.variation.id %}
{% set mainImg = itemData.images.all | orderByKey('position') | first %}

{# === Services & Daten === #}
{% set detailurl = services.url.getCanonicalURL() %}
{% set variationsWithAttributes = services.item.getVariationAttributeMap(itemId) %}
{% set variationList = services.item.getVariationList(itemId, true) %}
{% set basketItems = services.basket.getBasketForTemplate() %}
{% set basePriceList = getBasePriceList(variationList) %}
{% set crossSellingList = services.item.getItemCrossSellingList(itemId) %}
{% set enabledRoutes = config("IO.routing.enabled_routes") | split(', ') %}
{% set lang = services.localizationRepository.getLanguage() %}
{% set itemAttributes = services.item.getAttributeNameMap(itemId) %}
{% set isInWishList = services.wishList.isItemInWishList(variationId) %}
{% set itemPrices = itemData.prices %}
{% set hasRRP = itemPrices.rrp is defined and itemPrices.rrp.price.value != 0 and itemPrices.rrp.price.value > itemPrices.default.unitPrice.value %}
 
{% import "Ceres::PageDesign.Macros.ItemName" as ItemName %}
{% block PartialHead %}
{% if isQuickView %}
    <link rel="preload" href="{{ itemData.images.all[0].urlMiddle }}" as="image">
{% set vendorlogo = itemData.item.manufacturer.logo | replace({'https://cdn02.outlet46.de/frontend/vendor/': 'https://cdn02.outlet46.de/plugin/428/guardiansbasic/images/vendors/'}) %}
{% if vendorlogo and itemData.item.manufacturer.url is not empty %}
<link rel="preload" href="{{ vendorlogo }}" as="image">    
{% elseif itemData.item.manufacturer.logo and itemData.item.manufacturer.url is not empty %}
<link rel="preload" href="{{ itemData.item.manufacturer.logo }}" as="image">{% endif %}
{% endif %}
    {% embed getPartial('page-metadata') %}
        {% block title          ItemName.get(itemData | itemName, itemData.variation.bundleType) %}
        {% block description    itemData.texts.metaDescription %}
        {% block keywords       itemData.texts.keywords %}
        {% block image          itemData.images.all[0].url %}
        {% block schemaOrg %}
            {
                "@context"      : "http://schema.org/",
                "@type"         : "Product",
                "@id"           : "{{ itemData.variation.id }}",
                "name"          : "{{ ItemName.get(itemData | itemName, itemData.variation.bundleType) | trim }}",
                "category"      : "{{ defaultCategory.details[0].name | raw  }}",
                "releaseDate"   : "{{ itemData.variation.releasedAt }}",
                "image"         : "{{ itemData.images.all[0].urlMiddle }}",
                "identifier"    : "{{ itemData.variation.id }}",
                "description"   : "{{ itemData.texts.description | striptags | filterTabs }}",
                "disambiguatingDescription" : "{{ itemData.texts.shortDescription }}",
                "brand"         : {
                    "@type"         : "Brand",
                    "name"          : "{{ itemData.item.manufacturer.externalName }}"
                },
                "manufacturer"  : {
                    "@type"         : "Organization",
                    "name"          : "{{ itemData.item.manufacturer.externalName }}"
                },
                "sku"           : "{{ itemData.variation.number }}",
                "gtin13"          : "{{ itemData.barcodes[0].code }}",
                "offers": {
                    "@type"         : "Offer",
                    "priceCurrency" : "{{ itemData.prices.default.currency }}",
                    "price"         : "{{ itemData.prices.default.unitPrice.value | number_format(2, '.', '') }}",
                    "priceValidUntil": "2040-11-20",
                    "url"           : "{{ detailurl }}",
                    {% if itemData.prices.default.baseLot > 0 %}
                    "priceSpecification": {
                        "@type": "UnitPriceSpecification",
                        "price": "{{ item.documents[0].data.prices.default.baseSinglePrice | number_format(2, '.', '') }}",
                        "priceCurrency": "{{ item.documents[0].data.prices.default.currency }}",
                        "priceValidUntil": "2040-11-20",
                        "referenceQuantity": {
                            "@type": "QuantitativeValue",
                            "value": "{{ item.documents[0].data.prices.default.baseLot }}",
                            "unitCode": "{{ item.documents[0].data.prices.default.baseUnit }}"
                        }
                    },
                    {% endif %}
                    "availability"  : "{{ itemData.variation.availability.mappedAvailability }}",
                    "itemCondition" : "{{ conditionOfItem }}",
                    "serialNumber"  : "{{ itemData.variation.number }}"
                },
                "depth": {
                    "@type"         : "QuantitativeValue",
                    "value"         : "0"
                },
                "width": {
                    "@type"         : "QuantitativeValue",
                    "value"         : "0"
                },
                "height": {
                    "@type"         : "QuantitativeValue",
                    "value"         : "0"
                },
                "weight": {
                    "@type"         : "QuantitativeValue",
                    "value"         : "{{ itemData.variation.weightG }}"
                }
                {% if itemData.item.feedbackCount > 0 %}
                    ,"aggregateRating": {
                      "@type": "AggregateRating",
                      "ratingValue": "{{ itemData.item.feedbackDecimal }}",
                      "ratingCount": "{{ itemData.item.feedbackCount }}",
                      "bestRating": "5",
                      "worstRating": "1"
                    }
                {% endif %}
            }
        {% endblock %}
    {% endembed %}
{% endblock %}
{% block PageBody %}
{% if not isQuickView %}
<script>
(function () {
    try {
        var url = new URL(window.location.href);
        if (url.searchParams.get('quickViewItem') === 'true') {
            url.searchParams.delete('quickViewItem');
            window.location.replace(url.origin + url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : ''));
        }
    } catch (e) {
        console.warn('[MiniFailsafe] Fehler:', e);
    }
})();
</script>
{% endif %}
<article class="single" data-item data-eg-active-variation="{{ itemData.variation.id }}" data-mainitemid="{{ itemData.item.id }}">  
    <div class="container">
        <div class="d-lg-block clearfix">
            {% if isQuickView %}
            <div class="col-12 col-lg-7 col-xl-6 pull-lg-left stickyarticle z-index1">
                <div class="row">                   
                    <div class="col-md-2 col-lg-3 col-xl-2 d-none d-md-block">
                        {% if itemData.images.all | length>1 %}
                         {% set stepIndex = 0 %}
                        <div class="single-prev-images d-none d-md-block">
                            {% for prevImg in itemData.images.all  | orderByKey('position') %}
                                <a href="{{ prevImg.url }}" rel="zoom-id:ItemImgZoom" data-image="{{ prevImg.urlMiddle }}" title="{{ itemData | itemName }}" data-stepindex="{{ stepIndex - 3 }}">
                                    <img src="" data-src="{{ prevImg.urlSecondPreview }}" alt="{{ itemData | itemName }}" title="{{ itemData | itemName }}" class="lozad" width="100%" height="100%"/>
                                </a>
                                {% set stepIndex = stepIndex+1 %}
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    <div class="col-md-10 col-lg-9 col-xl-10">
                        {% set image = item.data.images.all | first %}
                        <div class="relative">
                            {% set storeSpecialClass = '' %}
                            {% set storeSpecialTxt = '' %}
                            {% if  item.data.item.storeSpecial.id == 2 %}
                                {% set storeSpecialClass = 'i-action-top' %}
                                {% set storeSpecialTxt = 'Top' %}
                            {% endif %}
                            {% if itemData.item.storeSpecial.id == 3 %}
                                {% set storeSpecialClass = 'i-action-new' %}
                                {% set storeSpecialTxt = 'Neu' %}
                            {% endif %}
							{% if hasRRP %}
                            {% set percent = (1 - itemPrices.default.unitPrice.value / itemPrices.rrp.unitPrice.value ) * -100 %}
                            {% set percent = percent | number_format(dezimalcount, ',', '.') %}
							{% set storeSpecialClass = 'i-action-sale' %}
							{% set storeSpecialTxt = '' %}
							{% endif %}
							{% if storeSpecialClass is not empty %}
							<span class="item-action {{ storeSpecialClass }}">
                                                            {{ storeSpecialTxt }}<span data-eg-item-rrp-percent>{{ percent }}</span>%
							</span>  
							{% endif %}
                                                        {% for tag in itemData.tags %}
                                                        {% if tag.id == 284 %}
                                                        <span class="item-action i-action-nachhaltig-item">{{ trans("GuardiansBasic::Template.sustainability") }}</span>
                                                        {% endif %}
                                                        {% endfor %}
                                                        <span class="wishlist-info1">
				<button aria-label="In die Merkliste" data-eg-event="click" data-eg-handler="watchListTrigger" class="btn btn-watch-h align-items-center justify-content-center btn-secondary wishlist-count1{% if isInWishList %} item-in-wishlist{% endif %}"><span class="icon-heart-o"></span></button>
                            </span>
                            <a href="{{ mainImg.url }}" aria-label="{{ itemData | itemName }}" title="{{ itemData | itemName }}" id="ItemImgZoom" class="MagicZoomPlus" data-options="zoomMode: off; transitionEffect: false; lazyZoom: true; cssClass: white-bg; textBtnClose: Closes; textBtnNext: Nexts; textBtnPrev: Previouss; textHoverZoomHint: ; textClickZoomHint: ; textExpandHint:    " data-mobile-options="zoomMode: off; textTouchZoomHint: ; textClickZoomHint: ; textExpandHint: ">
                                <img fetchpriority="high" src="{{ mainImg.urlMiddle }}" alt="{{ itemData | itemName }}" title="{{ itemData | itemName }}"  width="560px" height="560px">
                            </a>
                            {# Modeldaten zwischenspeichern – nur ein Loop! #}
                            {% set modelHeight = null %}
                            {% set modelWeight = null %}
                            {% set modelSize = null %}

                            {% for prop in item.documents[0].data.properties %}
                                {% if prop.property.id == 231 and prop.texts.value is not empty %}
                                    {% set modelHeight = prop.texts.value %}
                                {% elseif prop.property.id == 78 and prop.texts.value is not empty %}
                                    {% set modelWeight = prop.texts.value %}
                                {% elseif prop.property.id == 77 and prop.texts.value is not empty %}
                                    {% set modelSize = prop.texts.value %}
                                {% endif %}
                            {% endfor %}

                            {# Ausgabe nur wenn etwas vorhanden ist #}
                            {% if modelHeight is not empty %}
                            <div class="modelinfo-1" style="">
                              <span class="modelinfo-2" style="" data-darkreader-inline-bgcolor="">
                                <span class="modelinfo-3" style="" data-darkreader-inline-color="">
                                  {{ trans("GuardiansBasic::Template.ourmodelis") }} ({{ modelHeight }} {{ trans("GuardiansBasic::Template.cmtall") }}
                                  {% if modelWeight %} - {{ modelWeight }}{{ trans("GuardiansBasic::Template.kg") }}{% endif %})
                                  {% if modelSize %}
                                    <br>{{ trans("GuardiansBasic::Template.ourmodelwearssize") }}: {{ modelSize }}
                                  {% endif %}
                                </span>
                              </span>
                            </div>
                            {% endif %}

                            <div class="lupe-1"><span class="" style=""><span class="" style=""><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="s-icon s-icon-icon-zoom-in" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="m14.473 13.526-2.453-2.453a5.975 5.975 0 0 0 1.314-3.74 6 6 0 1 0-6 6 5.975 5.975 0 0 0 3.74-1.313l2.453 2.453c.26.26.687.26.947 0a.672.672 0 0 0 0-.947ZM2.668 7.333a4.663 4.663 0 0 1 4.667-4.667A4.663 4.663 0 0 1 12 7.333a4.673 4.673 0 0 1-1.34 3.273.142.142 0 0 1-.033.02l-.007.007c-.006.007-.013.02-.02.027a4.663 4.663 0 0 1-7.933-3.327Zm7.333 0A.67.67 0 0 1 9.334 8H8v1.333C8 9.7 7.7 10 7.333 10a.669.669 0 0 1-.666-.667V8H5.334a.669.669 0 0 1-.667-.667c0-.367.3-.667.667-.667h1.333V5.333c0-.367.3-.667.667-.667.366 0 .666.3.666.667v1.333h1.334c.366 0 .666.3.666.667Z"/></svg></span></span></div>
                            {% if itemData.images.all|length>1 %}
                            <button class="zoombtnnav zoomnavleft" aria-label="Bild zurück"><span class="icon-left-open-big fontGreen"></span></button>
                            <button class="zoombtnnav zoomnavright" aria-label="Bild vor"><span class="icon-right-open-big fontGreen"></span></button> 
                            {% endif %}
                            <div class="zoom-nav-list mt-3 mb-3 d-md-none"></div>
                        </div>
                    </div>
                </div>
            </div>
           {% endif %}
           {% if isQuickView %}
            <div class="col-12 col-lg-5 col-xl-6 pull-lg-right" data-eg-loading-attr>
                {% endif %}
                <h1 class="item-title" data-eg-item-title>{{ itemData | itemName }}</h1>
                 {% if isQuickView %}
                    {% if itemData.item.feedbackCount>0 %}
                        {% set percentTotal = (itemData.item.feedbackDecimal / 5) * 100 %}
                    <div class="item-ratings-top item-ratings-head clearfix d-inline-block item-ratings-first bew-abstand display-flex-important">
                        <div class="rating-grey f-size14">
                            {% for i in 1..5 %}
                            <span class="icon-star"></span>
                            {% endfor %}
                        </div>
                        <div class="rating-fuller" style="width: {{ percentTotal }}%"> 
                            <div class="rating-fuller-inner f-size14">
                                {% for i in 1..5 %}
                                <span class="icon-star"></span>
                                {% endfor %}
                            </div>
                        </div>
                    <div class="tab-rating-info"><a href="#tabrating" title="Bewertung {{ itemData.item.feedbackCount }}" class="slideToRating">{{ trans("GuardiansBasic::Template.ratingtitle") }}</a></div>
                    </div>
                    {% endif %}
                {% endif %}
                <hr class="hr-style">
                {% if isQuickView %}
                    {% if itemData.filter.hasManufacturer %}
                        {% set hasLogo = itemData.item.manufacturer.logo is not empty %}
                        {% set hasUrl = itemData.item.manufacturer.url is not empty %}
                        {% if hasLogo and hasUrl %}
                            {% set vendorlogo = itemData.item.manufacturer.logo | replace({'https://cdn02.outlet46.de/frontend/vendor/': 'https://cdn02.outlet46.de/plugin/428/guardiansbasic/images/vendors/'}) %}

                            {# Default-URLs setzen #}
                            {% set categoryURL = '#' %}
                            {% set categoryURLint = '#' %}

                            {# Wenn manufacturer.url numerisch ist, als categoryId behandeln #}
                            {% if itemData.item.manufacturer.url matches '/^[0-9]+$/' %}
                                {% set prodcatid = itemData.item.manufacturer.url | int %}
                                {% set categoryURLService = services.url.getCategoryURL(prodcatid) %}
                                {% set categoryURL = categoryURLService.toAbsoluteUrl(false) %}
                                {% set categoryURLint = categoryURLService.toAbsoluteUrl(true) %}
                            {% endif %}

                            <div class="col-5 pull-right">
                                <span class="item-producer-img mt-0">
                                    <a href="{{ lang == 'de' ? categoryURL : categoryURLint }}">
                                        <img src="{{ vendorlogo }}" alt="{{ itemData.item.manufacturer.externalName }} Logo" title="{{ itemData.item.manufacturer.externalName }}" width="100px" height="100px">
                                    </a>
                                </span>
                            </div>
                        {% endif %}
                    {% endif %}
                    <div class="col-7 padding-10-0{% if itemData.prices.graduatedPrices|length>1 %}hasGruadetPrices{% endif %}">
                            <span class="bold single-item-price"><span data-eg-item-price class="bold single-item-price">{{ itemPrices.default.data.unitPrice | number_format(2, ',', '.')}}</span> {{ currencyData[currencyFormat] }}</span>
                                {% set rabatt = (itemPrices.rrp.data.unitPrice - itemPrices.default.data.unitPrice) %}
                                {% set rabatt = rabatt | number_format(2, ',', '.') %}
                                <div class="cat-rrp-item"><span class="cat-rrp-item-price">{{ trans("GuardiansBasic::Template.statt") }} <span data-eg-item-rrp class="cat-rrp-item-price">{{ itemPrices.rrp.data.unitPrice | number_format(2, ',', '.')}}</span> {{ currencyData[currencyFormat] }}</span>*</div>
                                <div class="cat-rrp-item"><span class="single-item-rabatt">{{ trans("GuardiansBasic::Template.Dusparst") }} <span data-eg-item-rrp-spar class="single-item-rabatt">{{ rabatt }}</span> {{ currencyData[currencyFormat] }}!</span></div>                                                 
                    </div>
                    <div class="col-12 padding-10-0">   
                    {% if itemPrices.default.unitPrice.value>49 %}
                    <span class="sofort-lieferbar font-12">{{ trans("GuardiansBasic::Template.ab29") }}</span>
                    {% else %}
                    <span class="sofort-lieferbar font-12">{{ trans("GuardiansBasic::Template.u29") }}</span>  
                    {% endif %} 
                    {#<br>
                    <span class="sofort-lieferbar font-12">{{ trans("GuardiansBasic::Template.samedayshipping") }}</span>#}
                    </div>
                        {#<a href="#" data-eg-handler="modalContent" data-eg-type="modal-lg" data-eg-event="click" data-eg-href="{% if lang == "de" %}{% elseif lang == "en" %}/en{% elseif lang == "fr" %}/fr{% elseif lang == "it" %}/it{% elseif lang == "es" %}/es{% endif %}/getShopBuilderContent?categoryId=5934" data-eg-title="{{ trans("GuardiansBasic::Template.10percentcode") }}"><div class="benefit-detailview"><span class="benefit-detailview--text">{{ trans("GuardiansBasic::Template.10percentcode") }}</span></div></a>#}
                    <hr class="hr-style">
                {% endif %}

                {% if variationsWithAttributes[0].attributes  | length > 0 %}
                 {% if itemData.item.flagTwo!=3 %}   
                    {% set variationsWithAttributesWithFilter = [] %}
                    {% for variationWithAttribute in variationsWithAttributes %}
                        {% set isSalable = true %}
                        {% if services.item.getVariationIsSalable(variationWithAttribute.variationId) %}
                            {% set isSalable = false %}
                        {% endif %}
                        {% set withFilterSalable = variationWithAttribute|merge({'isSalable':  isSalable}) %}
                        {% set variationsWithAttributesWithFilter = variationsWithAttributesWithFilter|merge([withFilterSalable]) %}
                    {% endfor %}
                {% endif %}
                              {% for property in item.documents[0].data.properties %}
                                {% if property.property.id in [110, 73] %}
                                  <p class="margin-top-0-bottom-05{% if property.property.id == 110 %} f-size12" style="background-color: lightgrey; padding: 10px;{% endif %}">
                                    <span class="font-w700">
                                      {% if property.property.id == 73 %}{{ trans("GuardiansBasic::Template.fit") }}: {% endif %}{{ property.selection.name }}
                                    </span>
                                  </p>
                                {% endif %}
                              {% endfor %}
                <div data-item-variation class="row" data-eg-handler="initVariation" data-eg-event="load" data-eg-variations="{{ variationsWithAttributes | json_encode() }}">
                {% for itemAttribute in attributes %}
                    {% set activeAttrName = "" %}
                    <div class="col-md-12 padding-10-0">
                        {% set isColorAttr = false %}
                        {% set setBoxAttr = true %}
                        {% if "Farb" in itemAttribute.name or "Color" in itemAttribute.name %}
                            {% set isColorAttr = true %}
                        {% endif %}
                         <div data-item-variation-select class="{% if isColorAttr==true or setBoxAttr==true %}attribute-box{% else %}attribute-dropdown{% endif %}">
                             <p class="select-attr-name">{{ itemAttribute.name }}: <span data-eg-selected-attribute>{{ trans("GuardiansBasic::Template.selection") }}</span></p>
                             <p class="data-stock-warn"></p>
                            {% if "<table" in itemData.texts.technicalData|raw %}
                                <p class="size-chart-linkname">{{ trans("GuardiansBasic::Template.sizetable") }}</p>
                            {% endif %}
                             <ul data-eg-attributes="{{ itemAttribute.attributeId }}"  class="list-no-style clearfix">
                            {% for itemAttributeValue in itemAttribute.values %}
                                {% set itemSelected = "" %}
                                {% set isMainItem = true %}
                                {% set hasValidVariations = false %}
                                {% set activeVariationId = 0 %}
                                {% set variationAvailbilityId = 0 %}
                                {% if item.data.item.flagTwo!=3 %}
                                {% set mergedAttr = {} %}
                                {% set mergedAttr = mergedAttr|merge({("attributeId"):itemAttribute.attributeId}) %}
                                {% set mergedAttr = mergedAttr|merge({("attributeValueId"):itemAttributeValue.attributeValueId}) %}
                                
                                {% set mergedAttrArray = [] %}
                                {% set mergedAttrArray = mergedAttrArray|merge([mergedAttr]) %}
                                {% set attrIsSalable = false %}
                                {% for varitionData in variationsWithAttributesWithFilter %}
                                        {% for varAttr in varitionData.attributes %}
                                            {% if varAttr.attributeId == itemAttribute.attributeId and varAttr.attributeValueId == itemAttributeValue.attributeValueId %}
                                              {% if varitionData.isSalable %}
                                                {% set attrIsSalable = true %}
                                              {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                {% endfor %}
                                
                                {% endif %}
                                {% if itemData.item.flagTwo!=3 %}
                                <li {% if attrIsSalable != false %}data-eg-value="{{ itemAttributeValue.attributeValueId }}" data-eg-attrname="{{ itemAttributeValue.name  }}"{% else %}class="nosalable"{% endif %} data-eg-issalable="{{ attrIsSalable | json_encode() }}">
                                    {% if itemAttribute.type=="image" %}
                                        <img src="" data-src="{{ itemAttributeValue.imageUrl }}" alt="{{ itemAttributeValue.name }}" class="lozad" />
                                    {% else %}
                                        <span>{{ itemAttributeValue.name }}</span>
                                    {% endif %}
                                </li>
                                {% else %}
                                <li data-eg-value="{{ itemAttributeValue.attributeValueId }}" data-eg-attrname="{{ itemAttributeValue.name  }}">
                                    {% if itemAttribute.type=="image" %}
                                        <img src="" data-src="{{ itemAttributeValue.imageUrl }}" alt="{{ itemAttributeValue.name }}" class="lozad" />
                                    {% else %}
                                        <span>{{ itemAttributeValue.name }}</span>
                                    {% endif %}
                                </li>
                                {% endif %}
                                {% set activeAttrName = itemAttributeValue.name %}
                            {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endfor %}
                </div>
                {% else %} 
                {% if itemData.stock.net<7 %}
                <p class="data-stock-warn tcenter">{{ trans("GuardiansBasic::Template.bpss1") }} {{ itemData.stock.net }} {{ trans("GuardiansBasic::Template.bpss2") }}</p>
                {% else %}
                <p class="data-stock-warn tcenter">{{ trans("GuardiansBasic::Template.bpss") }}</p>
                {% endif %}
                {% endif %} 
                            {# Ausgabe nur wenn etwas vorhanden ist #}
                            {% if modelHeight is not empty %}
                            <div class="" style="">
                              <span class="modelinfo-2" style="" data-darkreader-inline-bgcolor="">
                                <span class="modelinfo-3" style="" data-darkreader-inline-color="">
                                  {{ trans("GuardiansBasic::Template.ourmodelis") }} ({{ modelHeight }} {{ trans("GuardiansBasic::Template.cmtall") }}
                                  {% if modelWeight %} - {{ modelWeight }}{{ trans("GuardiansBasic::Template.kg") }}{% endif %})
                                  {% if modelSize %}{{ trans("GuardiansBasic::Template.ourmodelwearssize") }}: {{ modelSize }}
                                  {% endif %}
                                </span>
                              </span>
                            </div>
