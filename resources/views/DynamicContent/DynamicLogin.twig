
<div class="loginpreview-form">
    {% if services.customer.getContactId() <=0 %}
        <div class="login-form-wrap">
            <form class="login-form transition-long">
                <div class="form-group">
                    <label class="form-control-label" for="login-mail">{{ trans("GuardiansBasic::Template.email") }}</label>
                    <input type="email" class="form-control" id="login-mail" placeholder="{{ trans("GuardiansBasic::Template.email") }}">
                    <span class="error-input-msg">{{ trans("Ceres::Template.loginEnterConfirmEmail") }}</span>
                </div>
                <div class="form-group">
                    <label class="form-control-label" for="login-password">{{ trans("GuardiansBasic::Template.pw") }}</label>
                    <input type="password" class="form-control" id="login-password" placeholder="{{ trans("GuardiansBasic::Template.pw") }}">
                    <span class="error-input-msg">{{ trans("Ceres::Template.loginEmptyPassword") }}</span>
                </div> 
                <div class="d-flex justify-content-between align-items-center login-form-action">
                    <a href="javascript:void(0);" class="btn-link" data-eg-handler="tgClass" data-eg-event="click" data-eg-param=".loginpreview-form,show-pwd-reset">{{ trans("Ceres::Template.loginForgotPassword") }}?</a>
                    <button class="btn btn-primary btn-big" data-eg-handler="loginUser" data-eg-event="click">{{ trans("Ceres::Template.login") }}</button>
                </div>
            </form>
            <hr />
            <div class="loginpreview-register text-center">
                <div class="h2 m-b-1">{{ trans("GuardiansBasic::Template.registrationinfo") }}</div>
                <a href="{% if lang == "de" %}/registrieren/{% elseif lang == "en" %}/en/register/{% elseif lang == "fr" %}/fr/enregistrer/{% elseif lang == "it" %}/it/registrare/{% elseif lang == "es" %}/es/registrarse/{% endif %}" class="btn btn-secondary btn-small m-b-2">{{ trans("GuardiansBasic::Template.joinnow") }}</a>
            </div>

        </div>    
        <form class="pwdreset-form transition-long">
            <div class="form-info">
                {{ trans("Ceres::Template.loginForgotPasswordInfo") }}
            </div>
            <div class="form-group">
                <label class="form-control-label" for="login-mail">{{ trans("GuardiansBasic::Template.email") }}</label>
                <input type="email" class="form-control" id="pwd-reset-mail" placeholder="{{ trans("GuardiansBasic::Template.email") }}">
                <span class="error-input-msg">{{ trans("Ceres::Template.loginEnterConfirmEmail") }}</span>
            </div>
            <div class="d-flex justify-content-between align-items-center pwd-reset-action">
                <a href="javascript:void(0)" class="btn-link" data-eg-handler="tgClass" data-eg-event="click" data-eg-param=".loginpreview-form,show-pwd-reset">
                    <span class="left-open-mini"></span>&nbsp;
                    {{ trans("Ceres::Template.loginBackToLogin") }}
                </a> 
                <button class="btn btn-primary btn-big" data-eg-handler="pwdResetUser" data-eg-event="click">{{ trans("Ceres::Template.loginSend") }}</button> 
            </div>
        </form>  
    {% else %}
        {% set contactData = services.customer.getContact() %}
        <div class="loginpreview-form">
            <p class="h2">{{ trans("GuardiansBasic::Template.hello") }} {{ contactData.firstName }}</p>
            <p>{{ trans("GuardiansBasic::Template.Youareloggedin") }}!</p>
        </div>
        <hr />
        <div class="loginpreview-register text-center">
            <a href="{{ services.category.getURLById(5178) }}" class="btn btn-primary btn-small mb-2 mb-md-0">{{ trans("GuardiansBasic::Template.mykonto") }}</a>
            <button class="btn btn-secondary btn-small"  data-eg-handler="logoutUser" data-eg-event="click">{{ trans("GuardiansBasic::Template.logout") }}</button>
        </div>
    {% endif %}
</div>


